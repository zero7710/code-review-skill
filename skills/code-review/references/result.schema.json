{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Code review skill result",
  "oneOf": [
    { "$ref": "#/$defs/review" },
    { "$ref": "#/$defs/explanation" }
  ],
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "strings": { "type": "array", "items": { "$ref": "#/$defs/text" } },
    "snapshot": {
      "type": "string",
      "pattern": "^(git:([0-9a-f]{40}|[0-9a-f]{64})|worktree:.+)$"
    },
    "location": {
      "type": "object",
      "required": ["path", "line"],
      "properties": {
        "path": { "$ref": "#/$defs/text" },
        "line": { "type": "integer", "minimum": 1 },
        "end_line": { "type": "integer", "minimum": 1 },
        "side": { "enum": ["base", "head"] }
      },
      "additionalProperties": false
    },
    "locations": {
      "type": "array",
      "items": { "$ref": "#/$defs/location" }
    },
    "coverage": {
      "type": "object",
      "required": ["scope", "checked", "gaps"],
      "properties": {
        "scope": { "enum": ["full_change", "new_diff", "baseline", "manual"] },
        "checked": { "$ref": "#/$defs/strings" },
        "gaps": { "$ref": "#/$defs/strings" }
      },
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "required": ["name", "status", "detail"],
      "properties": {
        "name": { "$ref": "#/$defs/text" },
        "status": { "enum": ["passed", "failed", "not_run", "partial"] },
        "detail": { "$ref": "#/$defs/text" }
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": ["local_key", "claim", "disposition", "reason"],
      "properties": {
        "local_key": { "$ref": "#/$defs/text" },
        "claim": { "$ref": "#/$defs/text" },
        "disposition": { "enum": ["verified", "rejected", "duplicate", "pending"] },
        "reason": { "$ref": "#/$defs/text" },
        "locations": { "$ref": "#/$defs/locations" },
        "duplicate_of": { "$ref": "#/$defs/text" }
      },
      "if": { "properties": { "disposition": { "const": "duplicate" } } },
      "then": { "required": ["duplicate_of"] },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": ["candidate_key", "module", "stream", "severity", "origin", "root_cause", "trigger", "impact", "locations", "verification"],
      "properties": {
        "candidate_key": { "$ref": "#/$defs/text" },
        "module": { "$ref": "#/$defs/text" },
        "stream": { "enum": ["bug", "security"] },
        "severity": { "enum": ["Important", "Nit"] },
        "origin": { "enum": ["introduced", "pre_existing", "unknown"] },
        "root_cause": { "$ref": "#/$defs/text" },
        "trigger": { "$ref": "#/$defs/text" },
        "impact": { "$ref": "#/$defs/text" },
        "locations": { "$ref": "#/$defs/locations", "minItems": 1 },
        "verification": { "$ref": "#/$defs/strings", "minItems": 1 }
      },
      "additionalProperties": false
    },
    "update": {
      "type": "object",
      "required": ["prior_ref", "status", "reason"],
      "properties": {
        "prior_ref": { "$ref": "#/$defs/text" },
        "status": { "enum": ["still_present", "verified_fixed", "not_checked", "closed_with_reason"] },
        "reason": { "$ref": "#/$defs/text" },
        "locations": { "$ref": "#/$defs/locations" },
        "attempted_fix": { "$ref": "#/$defs/text" }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": ["schema_version", "kind", "snapshot", "base", "round", "coverage", "checks", "candidates", "findings", "updates", "outcome", "summary"],
      "properties": {
        "schema_version": { "const": 1 },
        "kind": { "const": "review" },
        "snapshot": { "anyOf": [{ "$ref": "#/$defs/snapshot" }, { "type": "null" }] },
        "base": { "anyOf": [{ "$ref": "#/$defs/snapshot" }, { "type": "null" }] },
        "round": { "type": ["integer", "null"], "minimum": 1, "maximum": 3 },
        "coverage": { "$ref": "#/$defs/coverage" },
        "checks": { "type": "array", "items": { "$ref": "#/$defs/check" } },
        "candidates": { "type": "array", "items": { "$ref": "#/$defs/candidate" } },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "updates": { "type": "array", "items": { "$ref": "#/$defs/update" } },
        "risk": {
          "type": "object",
          "required": ["tier", "reason"],
          "properties": {
            "tier": { "enum": ["low", "medium", "high", "unknown"] },
            "reason": { "$ref": "#/$defs/text" },
            "human_decision": { "$ref": "#/$defs/text" }
          },
          "additionalProperties": false
        },
        "outcome": { "enum": ["clear", "needs_fix", "needs_human", "incomplete"] },
        "summary": { "$ref": "#/$defs/text" },
        "next_action": { "$ref": "#/$defs/text" }
      },
      "allOf": [
        {
          "if": { "properties": { "outcome": { "const": "incomplete" } } },
          "then": { "properties": { "coverage": { "properties": { "gaps": { "minItems": 1 } } } } },
          "else": { "properties": {
            "snapshot": { "$ref": "#/$defs/snapshot" },
            "coverage": { "properties": { "checked": { "minItems": 1 } } },
            "checks": { "minItems": 1 }
          } }
        },
        {
          "if": { "properties": { "outcome": { "const": "clear" } } },
          "then": { "properties": {
            "candidates": { "items": { "properties": { "disposition": { "enum": ["rejected", "duplicate"] } } } },
            "findings": { "maxItems": 0 },
            "updates": { "items": { "properties": { "status": { "enum": ["verified_fixed", "closed_with_reason"] } } } }
          } },
          "else": { "required": ["next_action"] }
        },
        {
          "if": { "properties": { "round": { "const": 3 } } },
          "then": { "properties": {
            "coverage": { "properties": { "scope": { "const": "new_diff" } } },
            "outcome": { "enum": ["clear", "needs_human", "incomplete"] }
          } }
        },
        {
          "if": { "properties": { "round": { "type": "integer" }, "outcome": { "enum": ["clear", "needs_fix", "needs_human"] } } },
          "then": { "properties": { "base": { "$ref": "#/$defs/snapshot" } } }
        }
      ],
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": ["id", "label", "location"],
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "label": { "$ref": "#/$defs/text" },
        "location": { "$ref": "#/$defs/location" }
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": ["from", "to", "label"],
      "properties": {
        "from": { "$ref": "#/$defs/text" },
        "to": { "$ref": "#/$defs/text" },
        "label": { "$ref": "#/$defs/text" }
      },
      "additionalProperties": false
    },
    "explanation": {
      "type": "object",
      "required": ["schema_version", "kind", "snapshot", "question", "answer", "nodes", "edges"],
      "properties": {
        "schema_version": { "const": 1 },
        "kind": { "const": "explanation" },
        "snapshot": { "$ref": "#/$defs/snapshot" },
        "question": { "$ref": "#/$defs/text" },
        "answer": { "$ref": "#/$defs/text" },
        "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/node" } },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
        "selected_node": { "$ref": "#/$defs/text" },
        "open_questions": { "$ref": "#/$defs/strings" }
      },
      "additionalProperties": false
    }
  }
}
